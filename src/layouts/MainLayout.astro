---
import "~/styles/global.css";
import Head from "~/components/Head.astro";
interface Props {
  title?: string;
  description?: string;
  imagePath?: string;
}

const props = Astro.props;
---

<!doctype html>
<html lang="en">
  <Head {...props} />
  <script
    defer
    is:inline
    src="https://static.cloudflareinsights.com/beacon.min.js"
    data-cf-beacon='{"token": "a2ab3c749177479d965530d31b29ce65"}'></script>
  <body class="bg-background text-foreground font-custom-serif p-4 font-light">
    <div class="mx-auto mt-8 max-w-screen-sm sm:mt-16">
      <slot />
    </div>
  </body>
</html>
