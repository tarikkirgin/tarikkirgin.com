---
import MainLayout from "~/layouts/MainLayout.astro";
import { getCollection } from "astro:content";
import ArticleList from "~/components/writing/ArticleList.astro";

const writing = await getCollection("writing");
---

<MainLayout>
  <header class="mb-4 flex flex-col gap-1">
    <h1 class="mb-1 text-3xl font-semibold">Tarik Kirgin</h1>
  </header>
  <main class="*:my-6">
    <section class="*:my-4">
      <p>
        Welcome! I am a Computer Science student in my final year at the <a
          class="link"
          href="https://www.leeds.ac.uk"
          target="_blank">University of Leeds</a
        >.
      </p>
      <div class="flex justify-center py-2">
        <ul
          class="xxxs:flex-row xxxs:list-none xxxs:gap-2 xxs:gap-6 flex list-[star] flex-col justify-between gap-1"
        >
          <li>
            <a
              href="https://www.linkedin.com/in/tarikkirgin"
              target="_blank"
              class="link">LinkedIn</a
            >
          </li>
          <li aria-hidden="true" class="xxxs:block hidden">✶</li>
          <li>
            <a
              href="https://github.com/tarikkirgin"
              target="_blank"
              class="link">GitHub</a
            >
          </li>
          <li aria-hidden="true" class="xxxs:block hidden">✶</li>
          <li>
            <a href="mailto:mail@tarikkirgin.com" class="link">E-mail</a>
          </li>
        </ul>
      </div>
    </section>
    <section>
      <h2 class="xxs:mb-4 mb-2 text-xl font-medium">Projects</h2>
      <ul class="ml-4 list-outside list-[star]">
        <li>
          <span class="mb-1 flex flex-wrap items-center gap-x-2">
            <a
              href="https://www.balatrodle.com"
              target="_blank"
              class="link text-lg whitespace-nowrap">Balatrodle</a
            >
            <span class="text-muted text-sm">Next.js, TypeScript, Tailwind</span
            >
          </span>
          <ul class="ml-7 list-[hyphen]">
            <li>
              Wordle-inspired guessing game based on the indie video game
              Balatro
            </li>
            <li>1.4M+ all-time visits</li>
          </ul>
        </li>
      </ul>
    </section>
    <section>
      <h2 class="xxs:mb-4 mb-2 text-xl font-medium">Writing</h2>
      <ArticleList writing={writing} />
    </section>
  </main>
</MainLayout>
