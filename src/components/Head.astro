---
import ThemeScript from "~/components/theme/ThemeScript.astro";
import { Font } from "astro:assets";
import { siteConfig } from "~/consts";

interface Props {
  title?: string;
  description?: string;
  imagePath?: string;
}

const { props } = Astro;

const title =
  props.title && siteConfig.titleTemplate
    ? siteConfig.titleTemplate.replace("%s", props.title)
    : siteConfig.title;

const description = props.description ?? siteConfig.description;

const imageURL = props.imagePath
  ? new URL(props.imagePath, Astro.url)
  : new URL(siteConfig.imagePath, Astro.url);
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="Tarik Kirgin" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>
  <meta name="title" content={title} />
  <meta name="description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={Astro.url} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={imageURL} />
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={Astro.url} />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />
  <meta property="twitter:image" content={imageURL} />
  <ThemeScript />
  <Font cssVariable="--font-platypi" />
  <Font cssVariable="--font-jetbrains-mono" />
  <Font cssVariable="--font-space-grotesk" />
</head>
